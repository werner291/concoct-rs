#!/usr/bin/env python
from __future__ import print_function

import sys
import logging
import vbgmm


from concoct.output import Output
from concoct.parser import arguments


def main(args):
    # Initialize output handling
    Output(args.basename, args)

    # Load composition + coverage and join in Rust
    data, contig_ids, column_names = vbgmm.load_and_join(
        args.composition_file,
        args.coverage_file,  # None if not provided
        args.kmer_length,
        args.length_threshold,
        args.no_cov_normalization,
        not args.no_total_coverage,
        args.read_length,
    )

    n_contigs = data.shape[0]

    if n_contigs < 2:
        logging.error('Not enough contigs pass the threshold filter. Exiting!')
        sys.exit(-1)

    # Fix special case in pca_components
    if args.pca_components == "All":
        args.pca_components = data.shape[1]

    # PCA (Rust via LAPACK dgesdd)
    transform_filter, pca_components, n_pca = vbgmm.perform_pca(
        data,
        float(args.pca_components),
    )

    logging.info('Performed PCA, resulted in %s dimensions' % n_pca)

    if not args.no_original_data:
        Output.write_original_data(
            data,
            args.length_threshold,
            contig_ids,
            column_names,
        )

    Output.write_pca(
        transform_filter,
        args.length_threshold,
        contig_ids,
    )

    Output.write_pca_components(
        pca_components,
        args.length_threshold,
    )

    logging.info('PCA transformed data.')

    logging.info('Will call vbgmm with parameters: %s, %s, %s, %s, %s' % (
        Output.CONCOCT_PATH, args.clusters, args.length_threshold,
        args.threads, args.iterations))

    assign = vbgmm.fit(
        transform_filter,
        int(args.clusters),
        int(args.seed),
        int(args.threads),
        int(args.iterations),
    )

    Output.write_assign(
        assign,
        args.length_threshold,
        contig_ids,
    )

    logging.info("CONCOCT Finished")


if __name__ == "__main__":
    args = arguments()
    if args.total_percentage_pca == 100:
        args.pca_components = "All"
    else:
        args.pca_components = args.total_percentage_pca / 100.0

    if args.threads == 1:
        logging.warning("CONCOCT is running in single threaded mode. "
                        "Please, consider adjusting the --threads parameter.")
    results = main(args)

    logging.info("CONCOCT Finished, the log shows how it went.")
